rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }
    
    function isOwner(userId) {
      return request.auth.uid == userId;
    }

    function isAdmin() {
      // Check if the user has a custom claim 'admin' or is in a specific list
      // For now, we will assume all authenticated users are internal staff 
      // since this seems to be an internal tool ("GPECx SGC").
      // If there are public users, we need to be more specific.
      return isAuthenticated() && request.auth.token.email.matches('.*@gpecx.com.br'); 
    }

    // Default: Deny everything
    match /{document=**} {
      allow read, write: if false;
    }

    // Users Collection
    match /users/{userId} {
      allow read: if isAuthenticated(); // Internal users can read profiles
      allow write: if isOwner(userId); // Users can update their own profile
    }

    // Customers Collection
    match /customers/{customerId} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated();
    }
    
    // Quotes/Proposals Collection
    match /quotes/{quoteId} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated();
    }

    // Orders Collection
    match /orders/{orderId} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated();
    }

    // Vendors Collection
    match /vendors/{vendorId} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated();
    }

    // Products/Items Collection (if exists)
    match /products/{productId} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated(); 
    }

    // Categories Collection
    match /categories/{categoryId} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated();
    }

    // Product Types Collection
    match /product_types/{productTypeId} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated();
    }

    // Companies Collection
    match /companies/{companyId} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated();
    }

    // Rental Equipments Collection
    match /rental_equipments/{equipmentId} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated();
    }

    // Product Kits (Templates)
    match /product_kits/{kitId} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated();
    }

    // Settings Collection
    match /settings/{settingId} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated();
    }

    // Rental Equipments Collection
    match /rental_equipments/{equipmentId} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated();
    }

    // Settings Collection
    match /settings/{settingId} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated();
    }
  }
}
