rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    
    function isAuthenticated() {
      return request.auth != null;
    }

    // Default: Deny all
    match /{allPaths=**} {
      allow read, write: if false;
    }

    // Allow authenticated users to upload/read files
    // This can be refined to specific folders per user if needed e.g. /users/{userId}/...
    match /{allPaths=**} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated() 
                   && request.resource.size < 10 * 1024 * 1024; // Max 10MB
                   // && request.resource.contentType.matches('image/.*|application/pdf'); // Optional: restrict types
    }
  }
}
